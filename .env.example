# NewsAgent Environment Variables

# Override default refresh interval (seconds)
# NEWSAGENT_REFRESH_INTERVAL=30

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///data/newsagent.db
# DATABASE_URL=postgresql://user:password@host:5432/newsagent

# JWT Authentication
JWT_SECRET=change-me-to-a-random-string
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"

# CORS (comma-separated origins, or * for development)
CORS_ORIGINS=*

# Firebase Push Notifications (optional)
FIREBASE_CREDENTIALS_PATH=

# Discord webhook push (category-routed news to Discord channels)
# Master on/off for outbound Discord delivery in the backend service.
DISCORD_ENABLED=true
# Bot display name + avatar on posted messages (webhook override).
DISCORD_USERNAME=NewsAgent Squawk
DISCORD_AVATAR_URL=
# Per-webhook throttle (seconds) and auto-disable threshold for failing routes.
DISCORD_THROTTLE_SECONDS=2.5
DISCORD_MAX_ROUTE_FAILURES=5
# Only push articles newer than this (minutes) to avoid backlog floods on startup.
DISCORD_MAX_AGE_MINUTES=30
# How long to retain the sent-article dedup log (days).
DISCORD_SENT_RETENTION_DAYS=14
# Optional env-var fallback webhooks (the Discord page in the app is preferred).
# One per category; & and non-alphanumerics are stripped (m&a -> MA).
# DISCORD_WEBHOOK_GENERAL=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_UPGRADE=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_DOWNGRADE=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_EARNINGS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_FDA=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_MA=https://discord.com/api/webhooks/...

# Discord slash commands (Phase 2 — signed HTTP interactions, no gateway bot)
# Public key verifies incoming interactions (Developer Portal → General Information).
DISCORD_PUBLIC_KEY=
# App ID + bot token are only needed to REGISTER commands (scripts/register_discord_commands.py).
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
# Optional: register commands to one guild for instant updates (omit = global, ~1h).
DISCORD_GUILD_ID=

# TradingView live alerts (inbound webhook → live dashboard)
# Shared secret for the webhook. Passed as ?token=<secret> on the webhook URL
# (TradingView free tier can't send custom headers). If unset, the endpoint
# returns 503. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TRADINGVIEW_WEBHOOK_TOKEN=
# A burst of alerts sharing the same group key within this window (seconds)
# coalesces into one updating "episode" card instead of N rows.
COALESCE_WINDOW_SECONDS=60
# Comma-separated fields that define the coalescing group key.
COALESCE_GROUP_KEY=category,ticker
# Max number of alerts retained in each group's history.
ALERT_HISTORY_LIMIT=20
# Drop coalesced alert groups older than this (days).
ALERT_PRUNE_AFTER_DAYS=3
# Also forward inbound TradingView alerts to the per-category Discord routes.
TRADINGVIEW_FORWARD_DISCORD=false

# API URL for mobile app (set in mobile/src/api/client.ts)
# API_BASE_URL=https://your-backend.railway.app

# ── Catalyst board ────────────────────────────────────────────────────
# High-impact catalysts post once to Discord, routed by group. 70 is roughly
# the "drop what you're doing" line: buyouts, FDA decisions, dilution, halts.
CATALYST_ALERTS_ENABLED=true
CATALYST_ALERT_MIN_SCORE=70
CATALYST_ALERT_MAX_AGE_HOURS=6

# ── Grok live search (optional) ───────────────────────────────────────
# Reads X and the web for events breaking ahead of RSS. Everything works
# without a key; every Grok path is simply skipped.
# XAI_API_KEY=xai-...
XAI_MODEL=grok-4.6
GROK_SQUAWK_ENABLED=true
GROK_SQUAWK_INTERVAL=120
GROK_SQUAWK_WINDOW_MINUTES=30

# ── Source fan-out ────────────────────────────────────────────────────
TICKER_FANOUT_INTERVAL=90
TICKER_FANOUT_MAX=10
